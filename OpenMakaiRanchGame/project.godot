; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OpenMakaiRanch"
config/unique_name="com.noa3.openmakairanch"
config/quit_on_go_back=false
run/main_scene="res://scenes/Bootstrap.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameRoot="*res://src/App/GameRoot.cs"
SceneRouter="*res://src/App/SceneRouter.cs"
GodotUniversalMcpRuntime="*res://addons/godot_universal_mcp/runtime_bridge.gd"

[dotnet]

project/assembly_name="OpenMakaiRanch"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_universal_mcp/plugin.cfg")

[plugins]

godot_universal_mcp:enabled=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
scaling_3d/mode="bilinear"
scaling_3d/scale=0.85

rendering/environment/ssao/quality=2
rendering/environment/ssao/half_size=true
rendering/environment/ssil/quality=2
rendering/environment/ssil/half_size=true
rendering/environment/screen_space_reflection/half_size=true
rendering/environment/volumetric_fog/volume_size=64
rendering/environment/volumetric_fog/volume_depth=64
