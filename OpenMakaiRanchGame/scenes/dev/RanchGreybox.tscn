text = "Controls"
theme_override_font_sizes/font_size = 17

[node name="ControlsLabel" type="Label" parent="WorldHud/TutorialOverlay/HelpPanel/Inner"]
layout_mode = 2
text = "WASD / Arrows — Move\nShift — Sprint\nHold RMB — Orbit camera\nMouse Wheel — Zoom / inspect closely\nV — Toggle first-person\nR — Recenter camera\nF — Interact with a nearby station or resident\nTab — Select next worker\nM — Open management\nEsc — Return to world from ordinary management\nF1 — Open/close this help"
autowrap_mode = 2

[node name="LoopTitle" type="Label" parent="WorldHud/TutorialOverlay/HelpPanel/Inner"]
layout_mode = 2
text = "Basic Ranch Loop"
theme_override_font_sizes/font_size = 17

[node name="LoopLabel" type="Label" parent="WorldHud/TutorialOverlay/HelpPanel/Inner"]
layout_mode = 2
text = "1. Choose a worker with Tab.\n2. Assign work in the 3D ranch or full Management.\n3. Walk up to residents and press F to open their existing character details.\n4. STA is your daily budget for repeatable progress actions — walking, sprinting, exploring, shopping and ordinary dialogue are free.\n5. A prepared Evening/Night hot bath gives a Well Rested STA bonus tomorrow; a quick shower does not.\n6. Invite an eligible adult resident from Personal Time. An active companion can follow you around the ranch and town and react with thoughts.\n7. Advance the day when ready.\n8. At Night choose a night plan, then End Day.\n9. Review the Daily Report and adjust tomorrow's plan."
autowrap_mode = 2

[node name="TutorialToggle" type="CheckButton" parent="WorldHud/TutorialOverlay/HelpPanel/Inner"]
layout_mode = 2
text = "Show contextual tutorial hints"
button_pressed = true
tooltip_text = "Disable automatic tutorial cards. F1 Help remains available."

[node name="ResetTutorialButton" type="Button" parent="WorldHud/TutorialOverlay/HelpPanel/Inner"]
